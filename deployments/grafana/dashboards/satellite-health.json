          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT timestamp AS time, solar_panel_output as \"Solar output (W)\", battery_current * 10 as \"Battery current (A x10)\" FROM telemetry WHERE satellite_id = '$satellite' AND timestamp > $__timeFrom() AND timestamp < $__timeTo() ORDER BY timestamp ASC;"
        }
