          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (station_id) station_id as \"Station ID\", station_name as \"Location\", status as \"Status\", weather_state as \"Weather\", congestion as \"Congestion %\", latency as \"Latency (ms)\", bandwidth as \"Bandwidth (Mbps)\", explanation as \"Details\" FROM ground_station_health ORDER BY station_id, timestamp DESC;"
