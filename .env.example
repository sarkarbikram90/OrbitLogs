# Open SpaceOps — Environment Configuration
# Copy this file to .env and customize for your environment.
# DO NOT commit your .env file to version control.

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_REQUIRED
POSTGRES_DB=spaceops
DATABASE_URL=postgres://postgres:CHANGE_ME_REQUIRED@localhost:5432/spaceops

# --- Kafka ---
KAFKA_BROKERS=localhost:9092

# --- Collector ---
HTTP_PORT=8080
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
RAW_TOPIC=telemetry.raw
PROCESSED_TOPIC=telemetry.processed
INVALID_TOPIC=telemetry.invalid
GROUP_ID=telemetry-consumer-group

# --- Simulator ---
COLLECTOR_URL=http://localhost:8080/telemetry
SIM_FLEET_SIZE=5
SIM_FREQUENCY_MS=1000
SIM_SCENARIO=normal
SIM_DETERMINISTIC=false
SIM_SEED=42
METRICS_PORT=8081

# --- Logging ---
RUST_LOG=info

# --- Security / Access Control ---
# Generate a strong random key: openssl rand -hex 32
API_KEY=CHANGE_ME_REQUIRED
CORS_ALLOWED_ORIGIN=http://localhost:3000

# --- Kafka SASL / SSL Security (Optional) ---
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# KAFKA_SASL_USERNAME=your-username
# KAFKA_SASL_PASSWORD=your-password
# KAFKA_SSL_CA_LOCATION=/path/to/ca.pem
